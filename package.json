{
  "name": "chatlogUI",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --exclude \"**/.worktrees/**\" --exclude \"e2e/specs/**\"",
    "fixtures:check": "node scripts/validate-e2e-fixtures.mjs",
    "mock:chatlog": "node e2e/mock-chatlog-server/server.mjs",
    "e2e": "playwright test e2e/specs/core.spec.ts e2e/specs/advanced.spec.ts e2e/specs/privacy.spec.ts e2e/specs/p3c-semantic-discovery.spec.ts e2e/specs/p3e-privacy-diagnostics.spec.ts",
    "e2e:visual": "playwright test e2e/specs/visual.spec.ts",
    "e2e:a11y": "playwright test e2e/specs/a11y.spec.ts",
    "e2e:update-snapshots": "playwright test e2e/specs/visual.spec.ts --update-snapshots",
    "release:check:sidecar": "node scripts/verify-sidecar-artifacts.mjs --mode check",
    "release:check:sidecar:release": "node scripts/verify-sidecar-artifacts.mjs --target x86_64-pc-windows-msvc --mode release --stage-dir src-tauri/binaries",
    "release:check:sidecar:release:all-targets": "node scripts/verify-sidecar-artifacts.mjs --mode release --stage-dir src-tauri/binaries",
    "release:check:updater": "node scripts/verify-updater-manifest.mjs --bundle-root src-tauri/target --required-platforms windows-x86_64",
    "release:check:updater:all-platforms": "node scripts/verify-updater-manifest.mjs --bundle-root src-tauri/target --required-platforms windows-x86_64,darwin-x86_64,darwin-aarch64,linux-x86_64",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-virtual": "^3.13.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "d3-force-3d": "^3.0.6",
    "framer-motion": "^11",
    "lucide-react": "^1.17.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6",
    "three": "^0.184.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.7"
  }
}
